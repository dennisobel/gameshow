# Copy to .env and adjust. Every value below has a working default in
# docker-compose.yml, so `docker compose up` works with no .env at all.

# ---- ports (host side) -------------------------------------------------
# WEB_PORT is the only port a SERVER publishes (docker-compose.yml): the game, with
# the API and WebSockets proxied behind it. scripts/deploy.sh refuses to start if
# something else holds it. The rest are for local development only
# (docker-compose.dev.yml) and are bound to localhost, so they cannot collide with,
# or be reached from, anything else. Chosen to avoid what is already running locally.
API_PORT=8090
AI_PORT=8000
WEB_PORT=8088
POSTGRES_PORT=15432
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334

# ---- database ----------------------------------------------------------
POSTGRES_USER=ontheboard
POSTGRES_PASSWORD=ontheboard
POSTGRES_DB=ontheboard

# ---- api ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# Change this. Any value is accepted in development; production refuses to
# start with the default.
# The default below is PUBLIC (it is in this repository). Anyone who can reach
# the API can forge a login token with it, including an editor's. Replace it
# before the stack is reachable from anywhere but your own machine:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ORIGINS=http://localhost:5174,http://localhost:5199,http://localhost:8088
RUN_MIGRATIONS=true
SEED_ON_START=true
# Shared secret between the Go API and the Python AI service. The AI service
# is never exposed to browsers.
AI_SERVICE_TOKEN=dev-internal-token

# ---- ai service --------------------------------------------------------
# Leave OPENAI_API_KEY empty to run the deterministic fake provider: the whole
# generation graph still runs, offline and reproducibly. Set a real key to
# generate real questions. Put the key in .env, which is gitignored, and never
# in this file. (OPEN_AI_SECRET_KEY is accepted as an alternative name.)
OPENAI_API_KEY=
# auto | openai | fake
LLM_PROVIDER=auto

# One model per role. The split is deliberate:
#   STRONG  writes the questions
#   JUDGE   scores them. Keep it a DIFFERENT model from STRONG: a model grades
#           its own output generously. Needs to accept a low temperature.
#   FAST    plays the 60-person survey panel (~60 tiny calls per question), so it
#           must be cheap and must NOT be a reasoning model.
MODEL_STRONG=gpt-5.5
MODEL_JUDGE=gpt-5.4
MODEL_FAST=gpt-5.4-mini
# Optional, per role (minimal | low | medium | high). Empty = do not send.
REASONING_EFFORT_STRONG=
REASONING_EFFORT_JUDGE=
REASONING_EFFORT_FAST=
# Simulated survey respondents per question. Bigger = better board, more cost.
PANEL_SIZE=60
# Respondents per model call. 1 means one call per person, which collapses onto the
# most common answer; ~20 keeps the spread realistic and is ~6x cheaper.
PANEL_WAVE_SIZE=20
PANEL_CONCURRENCY=12
# false => every generated question lands in the human review queue (crawl).
AUTO_APPROVE=false
WORKER_ENABLED=true

# Optional. Both features stay off when unset.
LANGSMITH_API_KEY=
COHERE_API_KEY=

# ---- web ---------------------------------------------------------------
# `npm run dev` has its own settings: see apps/web/.env.example. Vite reads
# .env files from apps/web only, never from this folder.
#
# For the web container: leave BLANK. The app and API then share one address, so
# it works from any phone and through a tunnel. Set it only to serve the app from
# somewhere that cannot proxy /v1 (e.g. Netlify), pointing at the public API.
WEB_API_URL=

# --- The host's voice -------------------------------------------------------
# ElevenLabs text-to-speech. Leave the key blank and the host speaks with the
# browser's built-in voice instead. The key is read by the API container only.
ELEVENLABS_API_KEY=
# Default is "Adam", usable on every plan. Library voices need a paid plan.
ELEVENLABS_VOICE_ID=
# Quick lines (mid-round) and show lines (welcome, final, winner). Both are fast
# models at half a credit per character. eleven_v3 is more expressive but was
# measured at about five seconds a sentence and costs double: too slow to be live.
ELEVENLABS_MODEL_QUICK=eleven_flash_v2_5
ELEVENLABS_MODEL_SHOW=eleven_turbo_v2_5
# The most characters sent to ElevenLabs per day. A new line costs credits once;
# after that it is served from the database. Raise this on a paid plan.
VOICE_DAILY_CHARS=2500
