# Settings for `npm run dev` only. Copy to .env.local (which git ignores).
#
# In development the page (Vite, :5173) and the API (:8090) are on different
# ports, so the app needs the API's address. In the Docker image this is left
# blank on purpose: nginx serves the app and proxies /v1, so everything shares one
# address and it works from any device.
VITE_API_URL=http://localhost:8090
