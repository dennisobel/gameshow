{
  "name": "on-the-board",
  "private": true,
  "version": "0.1.0",
  "description": "On The Board: a two-player, AI-hosted game show. A monorepo of apps/web (React), apps/api (Go) and apps/ai (Python).",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ontheboard/web",
    "build": "npm run build --workspace @ontheboard/web",
    "preview": "npm run preview --workspace @ontheboard/web",
    "typecheck": "npm run typecheck --workspace @ontheboard/web"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
